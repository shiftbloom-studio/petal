{
  "name": "petal",
  "description": "Petal: a free, open-source Twitch chat overlay for OBS, with 7TV, BTTV and FFZ emotes, badges and name paints.",
  "homepage": "https://petal.shiftbloom.studio",
  "repository": "github:shiftbloom-studio/petal",
  "keywords": [
    "twitch",
    "twitch-chat",
    "chat-overlay",
    "obs",
    "streaming",
    "7tv",
    "bttv",
    "frankerfacez",
    "chatis"
  ],
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/fontshare.ts && vite dev",
    "build": "node scripts/fontshare.ts && vite build",
    "build:cloudflare": "node scripts/check-operator.ts && pnpm install --frozen-lockfile && pnpm typecheck && pnpm exec biome ci && pnpm test && pnpm build",
    "typecheck": "tsc && tsc -p tsconfig.worker.json",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
    "seo": "node --import ./test/register.ts scripts/seo.ts",
    "og": "node --import ./test/register.ts scripts/og.ts && pnpm seo",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^1.0.3",
    "@solidjs/start": "^2.2.3",
    "@suid/material": "^0.19.0",
    "darkreader": "^4.9.135",
    "solid-js": "^1.9.20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@cloudflare/workers-types": "^5.20261125.1",
    "nitro": "3.0.261103-rc",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.23.0"
}
