# Operator details for the imprint (/impressum, /imprint) and privacy policy.
# Copy to .env for local builds, or set them as build variables in Cloudflare Workers Builds.
# They are read at build time; `pnpm run build:cloudflare` fails when a required one is missing.
VITE_OPERATOR_NAME=Jane Doe
VITE_OPERATOR_BUSINESS=Example studio
VITE_OPERATOR_STREET=Example Street 1
VITE_OPERATOR_CITY=12345 Example Town
VITE_OPERATOR_EMAIL=hello@example.com
# Optional
VITE_OPERATOR_PHONE=
VITE_OPERATOR_VAT_ID=
